{
  "name": "pos-print-agent",
  "version": "1.0.0",
  "description": "Commercial Windows Desktop POS Print Agent for Cafe Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "cli": "node server.js",
    "virtual-printer": "node virtualPrinter.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "pos",
    "thermal-printer",
    "esc-pos",
    "laravel-reverb",
    "electron",
    "desktop-agent"
  ],
  "author": "Cafe System Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "laravel-echo": "^1.17.1",
    "pusher-js": "^8.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cafesystem.printagent",
    "productName": "Cafe Print Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.bat"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Cafe Print Agent",
      "artifactName": "Cafe-Print-Agent-Setup-${version}.${ext}"
    }
  }
}
